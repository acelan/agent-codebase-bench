# Copy to docker/.env.repowise (gitignored) and fill in the real values, then
# pass it to the docker build as a SECRET so the API key never lands in the
# image or build history:
#
#   cp docker/.env.repowise.example docker/.env.repowise   # edit the key/model
#   docker build -t agent-codebase-bench -f docker/Dockerfile \
#       --secret id=repowise_env,src=docker/.env.repowise .
#
# This key pays for `repowise generate` (LLM concept-page synthesis) when
# BUILD_INDEXES=1 bakes the repowise index focused on the benchmark subtrees
# (drivers/gpu/drm/i915 + drivers/usb/typec). It is used only at build time and
# is scrubbed from the image — runtime `repowise search` is offline.

# OpenRouter API key (or key of the provider REQUEST_MODEL resolves through).
OPENROUTER_API_KEY=sk-or-...

# Model used to synthesize wiki/concept pages. Any OpenRouter model id.
REPOWISE_MODEL=deepseek/deepseek-v4-flash-0731
