# Copy to docker/.env (gitignored) and fill in real values. One source of truth
# for the OpenRouter key and models used by index initialization and benchmark
# runs (the pi agent model).
#
#   cp docker/.env.example docker/.env            # edit key/models
#   docker build -t agent-codebase-bench -f docker/Dockerfile .
#   docker run --rm --env-file docker/.env \
#       -v "$(pwd)/artifacts:/workspace/artifacts" \
#       --entrypoint /usr/local/bin/pi-bench-index agent-codebase-bench build
#   docker run --rm --env-file docker/.env \
#       --entrypoint /usr/local/bin/pi-bench-run \
#       agent-codebase-bench --model openrouter/deepseek-v4-flash-0731 \
#       --tools grep,...                                      [examples]
#
# The key is used only by the explicit index initialization or benchmark run;
# it is never copied into the image or committed. Everything here is gitignored;
# only docker/.env.example is tracked.

# --- OpenRouter (single key pays pi-agent runs + repowise bake) ------------
OPENROUTER_API_KEY=sk-or-...

# --- pi agent (the model used to run benchmark cells) ----------------------
# Passed to the run as `--model "$PI_MODEL"`. Any OpenRouter model id.
PI_MODEL=openrouter/deepseek-v4-flash-0731

# --- repowise index initialization ------------------------------------------
# Provider + model for concept-page synthesis (defaults from PI_MODEL).
#REPOWISE_PROVIDER=openrouter
REPOWISE_MODEL=deepseek/deepseek-v4-flash-0731

# Reasoning effort for the synthesis model (auto|off|none|minimal|low|medium|
# high|xhigh|max). Optional; must also be added to prepare-index.sh export list.
#REPOWISE_REASONING=auto

# --- repowise embedder (semantic-search vectors; SEPARATE from LLM) --------
# `openrouter` gives REAL embeddings via the same key; unset defaults to repowise
# `mock` (dummy, non-semantic) vectors. Model must be one OpenRouter serves.
REPOWISE_EMBEDDER=openrouter
REPOWISE_EMBEDDING_MODEL=openai/text-embedding-3-small
#REPOWISE_EMBEDDING_DIMS=1536
#REPOWISE_EMBEDDING_TIMEOUT=60

# NOTE: the embedder above is read by repowise from CONFIG.YAML during
# `generate`, not reliably from env — if the external vector store comes out
# `Indexed 0 items (N failed)` the embeddings failed despite this section.
# Fix by setting embedder in the subtree's .repowise/config.yaml (and ensuring
# the embedding model is served by OpenRouter), then rebuild the external cache.
# Until then
# `repowise search` is full-text-only. See docs/pi-migration.md.
