# Copy to docker/.env (gitignored) and fill in real values. One source of truth
# for the OpenRouter key and models used by index initialization, benchmark runs,
# and report analysis. Matching summary-cache hits need no provider credentials.
#
#   cp docker/.env.example docker/.env            # edit key/models
#   docker build -t agent-codebase-bench -f docker/Dockerfile .
#   docker run --rm --env-file docker/.env \
#       -v "$(pwd)/artifacts:/workspace/artifacts" \
#       --entrypoint /usr/local/bin/pi-bench-index agent-codebase-bench build
#   docker run --rm --env-file docker/.env \
#       --entrypoint /usr/local/bin/pi-bench-run \
#       agent-codebase-bench --model openrouter/deepseek-v4-flash-0731 \
#       --tools grep,...                                      [examples]
#
# The key is used only by explicit index initialization, benchmark runs, or report
# analysis when no matching summary cache exists. Matching summary-cache hits need
# no provider credentials. It is never copied into the image or committed.
# Everything here is gitignored; only docker/.env.example is tracked.

# --- OpenRouter (pi-agent + report analysis + repowise use one key) --------
OPENROUTER_API_KEY=sk-or-...

# --- Ollama (optional local/remote provider) --------------------------------
# pi has no built-in ollama discovery; the provider must be declared in
# models.json. Set OLLAMA_BASE_URL and the harness writes the declaration
# automatically (docker/ollama-models.sh, or generated on the fly). Omit
# OLLAMA_BASE_URL to keep OpenRouter-only behavior.
#
#   OLLAMA_BASE_URL  base URL of the ollama OpenAI-compatible endpoint
#                    (default http://127.0.0.1:11434/v1)
#   OLLAMA_API_KEY   optional API key (ollama ignores it; remote
#                    OpenAI-compatible endpoints may require one)
#OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#OLLAMA_API_KEY=ollama

# --- pi agent (the model used to run benchmark cells) ----------------------
# Passed to the run as `--model "$PI_MODEL"`. For OpenRouter use any
# OpenRouter model id; for ollama use "ollama/<id>" (the id ollama serves,
# e.g. qwen2.5-coder:0.5b). The same PI_MODEL drives the ollama provider
# declaration — there is no separate OLLAMA_MODELS setting.
PI_MODEL=openrouter/deepseek-v4-flash-0731

# --- provider selection -----------------------------------------------------
# When BOTH OPENROUTER_API_KEY and OLLAMA_BASE_URL are present, PI_PROVIDER
# decides which one pi uses:
#   PI_PROVIDER=openrouter   (default when unset)
#   PI_PROVIDER=ollama
# CLI --provider / --model-preset still win over this.
#PI_PROVIDER=openrouter

# Optional report analyst model. Defaults to the benchmark PI_MODEL when omitted.
#PI_SUMMARY_MODEL=openrouter/deepseek-v4-flash-0731

# --- repowise index initialization ------------------------------------------
# Provider + model for concept-page synthesis (defaults from PI_MODEL).
#REPOWISE_PROVIDER=openrouter
REPOWISE_MODEL=deepseek/deepseek-v4-flash-0731

# Reasoning effort for the synthesis model (auto|off|none|minimal|low|medium|
# high|xhigh|max). Optional; must also be added to prepare-index.sh export list.
#REPOWISE_REASONING=auto

# --- repowise embedder (semantic-search vectors; SEPARATE from LLM) --------
# `openrouter` gives REAL embeddings via the same key; unset defaults to repowise
# `mock` (dummy, non-semantic) vectors. Model must be one OpenRouter serves.
REPOWISE_EMBEDDER=openrouter
REPOWISE_EMBEDDING_MODEL=openai/text-embedding-3-small
#REPOWISE_EMBEDDING_DIMS=1536
#REPOWISE_EMBEDDING_TIMEOUT=60

# NOTE: the embedder above is read by repowise from CONFIG.YAML during
# `generate`, not reliably from env — if the external vector store comes out
# `Indexed 0 items (N failed)` the embeddings failed despite this section.
# Fix by setting embedder in the subtree's .repowise/config.yaml (and ensuring
# the embedding model is served by OpenRouter), then rebuild the external cache.
# Until then
# `repowise search` is full-text-only. See docs/pi-migration.md.
