# Durable per-model benchmark run dirs (raw data + transcripts). These are the
# source for reports; keep them on disk but out of version control.
artifacts/

# Generated reports
report*.html

__pycache__/
*.pyc

# Secrets + models: OpenRouter key, pi-agent model, repowise model/embedder.
